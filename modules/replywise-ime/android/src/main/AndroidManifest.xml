<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- The Replywise keyboard. Merged into the app's manifest by Gradle (library manifest merge). -->
    <service
      android:name="app.replywise.ime.ReplywiseIme"
      android:label="@string/replywise_ime_label"
      android:permission="android.permission.BIND_INPUT_METHOD"
      android:exported="true">
      <intent-filter>
        <action android:name="android.view.InputMethod" />
      </intent-filter>
      <meta-data
        android:name="android.view.im"
        android:resource="@xml/method" />
    </service>
  </application>
</manifest>
