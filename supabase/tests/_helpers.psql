-- Shared pgTAP helpers, included by each test file with `\ir _helpers.psql` after `begin;`.
-- Everything here lives in the test transaction and is rolled back with it. This file is not a
-- test itself: `supabase test db` (pg_prove --ext .sql --ext .pg) skips .psql files.

create extension if not exists pgtap with schema extensions;

create schema tests;
grant usage on schema tests to anon, authenticated, service_role;

-- Inserts an auth user (anonymous by default, like v1 sign-in). The on_auth_user_created trigger
-- creates the profiles row.
create function tests.create_user(p_is_anonymous boolean default true)
returns uuid
language plpgsql
as $$
declare
  v_id uuid := gen_random_uuid();
begin
  insert into auth.users (id, aud, role, is_anonymous, created_at, updated_at)
  values (v_id, 'authenticated', 'authenticated', p_is_anonymous, now(), now());
  return v_id;
end;
$$;

-- Act as a signed-in (anonymous) user, the way PostgREST does for a user JWT.
create function tests.as_user(p_user_id uuid)
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims',
    json_build_object('sub', p_user_id, 'role', 'authenticated', 'is_anonymous', true)::text, true);
  perform set_config('role', 'authenticated', true);
end;
$$;

-- Act as the anon role (API key only, no user).
create function tests.as_anon()
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims', json_build_object('role', 'anon')::text, true);
  perform set_config('role', 'anon', true);
end;
$$;

-- Act as the service role (Edge Functions).
create function tests.as_service()
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims', json_build_object('role', 'service_role')::text, true);
  perform set_config('role', 'service_role', true);
end;
$$;

-- Back to the test owner (postgres). Plain `reset role` works because the session user is postgres.
create function tests.clear_claims()
returns void
language sql
as $$
  select set_config('request.jwt.claims', '', true);
$$;

-- Fixed fake key hashes for device key tests (64 lowercase hex chars).
create function tests.fake_hash(p_seed text)
returns text
language sql
immutable
as $$
  select encode(extensions.digest(p_seed, 'sha256'), 'hex');
$$;

grant execute on all functions in schema tests to anon, authenticated, service_role;
