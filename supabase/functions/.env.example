# Edge Function secrets: names only, never values in the repo.
# Hosted projects: `supabase secrets set NAME=value --project-ref <ref>`.
# Local: copy to supabase/functions/.env (git-ignored) for `supabase functions serve`.

# local | staging | production. Production refuses LLM_MODE=fake and (unless ALLOW_NON_EU_PROVIDER=true) anthropic.
APP_ENV=local
# fake (default; local and CI) | live
LLM_MODE=fake
# live only: bedrock | mistral | anthropic. Fallback is optional and must differ from the primary.
LLM_PROVIDER_PRIMARY=
LLM_PROVIDER_FALLBACK=
# "true" only after an explicit decision to use the direct Claude API in production (no EU-only processing).
ALLOW_NON_EU_PROVIDER=

# Direct Claude API (development/staging). Model defaults to claude-haiku-5-5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Amazon Bedrock, EU inference profile. Region must be eu-*, model ID must start with "eu.".
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_REGION=eu-central-1
BEDROCK_MODEL_ID=

# Mistral La Plateforme (EU).
MISTRAL_API_KEY=
MISTRAL_MODEL=

# Later prompts.
REVENUECAT_WEBHOOK_SECRET=
POSTHOG_KEY=
SENTRY_DSN=
DAILY_COST_ALERT_EUR=
