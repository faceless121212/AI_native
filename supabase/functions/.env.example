# Edge Function secrets: names only, never values in the repo.
# Hosted projects: `supabase secrets set NAME=value --project-ref <ref>`.
# Local: copy to supabase/functions/.env (git-ignored) for `supabase functions serve`.

# local | staging | production. On hosted Supabase an unset APP_ENV means production and `local`
# is refused. Production refuses LLM_MODE=fake and the anthropic provider (no override).
APP_ENV=local
# fake | live. Unset: fake locally; refused on hosted Supabase (set it explicitly).
LLM_MODE=fake
# live only: bedrock | mistral | anthropic. Fallback is optional and must differ from the primary.
LLM_PROVIDER_PRIMARY=
LLM_PROVIDER_FALLBACK=

# Direct Claude API (development/staging only). Model defaults to claude-haiku-5-5.
# Never set ANTHROPIC_LOG, ANTHROPIC_BASE_URL, ANTHROPIC_BEDROCK_BASE_URL, ANTHROPIC_AUTH_TOKEN,
# ANTHROPIC_CUSTOM_HEADERS or ANTHROPIC_OPEN_TELEMETRY*: staging and production refuse to start.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Amazon Bedrock, EU inference profile. Region: eu-central-1, eu-west-1, eu-west-3, eu-south-1,
# eu-south-2 or eu-north-1 (EU members only; not London or Zurich). Model ID must start with "eu.".
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_REGION=eu-central-1
BEDROCK_MODEL_ID=

# Mistral La Plateforme (EU).
MISTRAL_API_KEY=
MISTRAL_MODEL=

# Later prompts.
REVENUECAT_WEBHOOK_SECRET=
POSTHOG_KEY=
SENTRY_DSN=
DAILY_COST_ALERT_EUR=
