# Copy to .env (never committed). Only EXPO_PUBLIC_* values reach the app bundle; they are public by design.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_REPLY_FUNCTION_URL=

# Build/dev-time only, never shipped in the app.
# Leave APP_VARIANT unset for app.replywise; set it to "staging" for app.replywise.staging.
# APP_VARIANT=staging
# Your Apple Developer Team ID (developer.apple.com → Membership). Signs the app and the keyboard.
APPLE_TEAM_ID=
# EAS project ID, printed by `eas init`.
EAS_PROJECT_ID=

# Local design tooling only (fal.ai, for icons and images). Never prefix with EXPO_PUBLIC_.
FAL_KEY=

# Edge Function secrets are NOT set here. Use `supabase secrets set` (see CLAUDE.md).
