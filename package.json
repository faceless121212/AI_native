{
  "name": "replywise",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "~58.0.22",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.29",
    "expo-status-bar": "~58.0.4",
    "i18next": "^26.5.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.9",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@bacons/apple-targets": "5.0.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.13",
    "prettier": "^3.9.10",
    "test-renderer": "1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "i18n:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/i18n-check.ts",
    "evals": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/evals.stub.js",
    "gen:keyboard-strings": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/gen-keyboard-strings.ts",
    "gen:tokens": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/export-tokens.ts",
    "gen": "npm run gen:tokens && npm run gen:keyboard-strings"
  },
  "private": true,
  "engines": {
    "node": ">=22.18"
  }
}
